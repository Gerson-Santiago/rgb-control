#!/bin/bash
# Pipeline Reference: .agents/workflows/pipeline.md
#
# Git Hook: commit-msg
# Enforça a convenção de commits (Conventional Commits).

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Expressão regular para Conventional Commits
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .+$"

if [[ ! "$commit_msg" =~ $pattern ]]; then
    echo -e "\n❌ Erro: A mensagem de commit não segue o padrão Conventional Commits!"
    echo -e "Mensagem tentada: '$commit_msg'"
    echo -e "Padrão esperado: tipo(escopo): descrição"
    echo -e "Exemplos:"
    echo -e "  feat(gui): adiciona botão de atalho"
    echo -e "  fix(daemon): corrige vazamento de descritores"
    echo -e "  chore: atualiza dependências\n"
    exit 1
fi
